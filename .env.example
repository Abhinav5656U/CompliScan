FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://postgres:password@localhost:5432/compliscan
JWT_SECRET_KEY=your-jwt-secret-here
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
GEMINI_API_KEY=your-gemini-api-key-placeholder
GOOGLE_APPLICATION_CREDENTIALS=../service-account.json
GROQ_API_KEY=your-groq-api-key-placeholder
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
REDIS_URL=redis://localhost:6379
USE_LOCAL_MODELS=true
OFFICER_REGISTRATION_TOKEN=your-secure-officer-registration-token
